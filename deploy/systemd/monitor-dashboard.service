[Unit]
Description=Monitor Dashboard Backend
Documentation=https://github.com/example/monitor-dashboard
After=network.target

[Service]
Type=simple
User=monitor
Group=monitor
ExecStart=/usr/local/bin/monitor-backend --config /etc/monitor-dashboard/config.toml
Restart=on-failure
RestartSec=5

# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/log
PrivateTmp=yes

# NVML requires access to NVIDIA device nodes
DeviceAllow=/dev/nvidiactl rw
DeviceAllow=/dev/nvidia0 rw
DeviceAllow=/dev/nvidia1 rw
DeviceAllow=/dev/nvidia2 rw
DeviceAllow=/dev/nvidia3 rw
DeviceAllow=/dev/nvidia4 rw
DeviceAllow=/dev/nvidia5 rw
DeviceAllow=/dev/nvidia6 rw
DeviceAllow=/dev/nvidia7 rw

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=monitor-dashboard

[Install]
WantedBy=multi-user.target
